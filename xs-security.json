{
  "xsappname": "EvoEdge_Dashboard_EvoedgeSolutionsLimited_Dev",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.User",
      "description": "Grants access to CAP OData service"
    },
    {
      "name": "$XSAPPNAME.Callback",
      "description": "Callback scope",
      "grant-as-authority-to-apps": [
        "$XSAPPNAME(application,sap-provisioning,workflow)"
      ]
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Basic Viewer Role",
      "scope-references": [
        "$XSAPPNAME.User"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "http://localhost:*/**",
      "https://*.hana.ondemand.com/**"
    ]
  }
}

            <FlexBox
    direction="Row"
    justifyContent="SpaceBetween"
    wrap="Wrap"
    alignItems="Start"
    renderType="Div"
    class="dashboardGrid"
    items="{
        path: 'groupModel>/Groups',
        templateShareable: true
    }">
    
    
    <VBox class="machineDashboardCard sapUiTinyMarginEnd">
        <layoutData>
            <FlexItemData growFactor="0" />
        </layoutData>

        <!-- <MessageStrip
            text="{= 'Attention required: ' + ${groupModel>Machine_Id_Error_Id} }"
            visible="{= !!${groupModel>Machine_Id_Error_Id} }"
            type="Error"
            showIcon="true"
            class="sapUiMediumMarginBottom customStripHighlight" /> -->

        <VBox height="5rem" class="messageStripWrapper sapUiSmallMarginBottom">
            <MessageStrip
                text="{= 'Attention required: ' + ${groupModel>Machine_Id_Error_Id} }"
                visible="{= !!${groupModel>Machine_Id_Error_Id} }"
                type="Error"
                showIcon="true"
                class="customStripHighlight" />
            </VBox>


        <Text text="{groupModel>Machine_Type_Name} Machines" class="machineListLabel centerText" />

        <VBox class="sapUiSmallMargin">
    
        <!-- <ObjectStatus 
            text="Pressure &lt; 200" 
            state="Success"
            icon="sap-icon://sys-enter-2" 
            class="sapUiTinyMarginBottom mediumTitle"/>
            
        <ObjectStatus 
            text="Pressure 201–239" 
            state="Warning"
            icon="sap-icon://alert"
            class="sapUiTinyMarginBottom mediumTitle" />
            
        <ObjectStatus 
            text="Pressure ≥ 240" 
            state="Error"
            icon="sap-icon://error"
            class="sapUiTinyMarginBottom mediumTitle" /> -->

            <ObjectStatus 
                text="{= ${groupModel>Machine_Type}.startsWith('BR') ? 'Temperature ≤ 800' : 
                            ${groupModel>Machine_Type}.startsWith('CM') ? 'Temperature ≤ 1000' : 
                            'Pressure = 8'}" 
                state="Success" 
                icon="sap-icon://sys-enter-2" 
                class="sapUiTinyMarginBottom mediumTitle"/>
            <ObjectStatus 
                text="{= ${groupModel>Machine_Type}.startsWith('BR') ? 'Temperature 801–850' : 
                            ${groupModel>Machine_Type}.startsWith('CM') ? 'Temperature 1001–1050' : 
                            'Pressure = 7'}" 
                state="Warning" 
                icon="sap-icon://alert"
                class="sapUiTinyMarginBottom mediumTitle"/>

                <ObjectStatus 
                text="{= ${groupModel>Machine_Type}.startsWith('BR') ? 'Temperature &gt; 850' : 
                            ${groupModel>Machine_Type}.startsWith('CM') ? 'Temperature &gt; 1050' : 
                            'Pressure &lt; 6 or &gt; 8'}" 
                state="Error" 
                icon="sap-icon://error"
                class="sapUiTinyMarginBottom mediumTitle"/>
    </VBox>

        <core:HTML content='&lt;canvas id="{groupModel>GaugeId}" width="150" height="100"&gt;&lt;/canvas&gt;' class="cardGauge" />

        <VBox items="{
            path: 'groupModel>Machines',
            templateShareable: true
        }">
            <HBox alignItems="Center" justifyContent="Start" class="machineListItem">
                <Text text="{groupModel>Machine_Id}" width="60px" class="sapUiSmallMarginEnd" />
                <ProgressIndicator
                    percentValue="{groupModel>Value}"
                    displayValue="{= ${groupModel>Value} + ' ' + ${groupModel>measurement} }"
                    state="{groupModel>State}"
                    class="idProgressIndicator" />
            </HBox>
        </VBox>
    </VBox>
</FlexBox>


            			


        </f:content>

    </f:DynamicPage>
</mvc:View>
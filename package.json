{
  "name": "EvoEdge_Dashboard",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "@cap-js/postgres": "^2.0.2",
    "@sap/cds-mtx": "^1.1.1",
    "@sap/cds-mtxs": "^3.0.1",
    "@sap/xssec": "^4",
    "express": "^4",
    "passport": "^0.7.0",
    "pg": "^8"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.10.0",
    "@cap-js/sqlite": "^2.0.0",
    "@sap/cds": "^9.0.3",
    "@sap/cds-dk": "^9.0.5"
  },
  "scripts": {
    "start": "cds run",
    "watch-machine_real_time_monitoring_dashboard": "cds watch --open machine_real_time_monitoring_dashboard/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "vcap": {
          "label": "postgresql-db",
          "plan": "standard",
          "name": "postgresdb"
        }
      },
      "auth": "xsuaa",
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "destinations": true,
      "html5-runtime": true,
      "workzone": true
    },
    "profile": "with-mtx-sidecar"
  }
}
